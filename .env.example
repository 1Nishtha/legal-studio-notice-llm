# =============================================================================
# Legal Notice Studio — local LLM service (copy to .env and adjust)
# Everything has a default; the service also starts without this file.
# =============================================================================

# ---- Server -----------------------------------------------------------------
PORT=4100
# Keep 127.0.0.1 unless the backend runs on another machine (then also set LLM_SERVICE_TOKEN)
HOST=127.0.0.1
LOG_LEVEL=info
# Optional shared secret: callers send "Authorization: Bearer <token>"
LLM_SERVICE_TOKEN=

# ---- Runtime (what runs the model) ---------------------------------------------
# ollama = Ollama on this machine (recommended)
# openai = any OpenAI-compatible server: llama.cpp llama-server, vLLM, LM Studio
# mock   = no model; schema-valid placeholder answers, for wiring tests only
RUNTIME=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OPENAI_BASE_URL=http://127.0.0.1:8080/v1
OPENAI_API_KEY=

# ---- Your models (one per tier) ------------------------------------------------
# Created from models/*.Modelfile:  ollama create legal-notice-reviewer -f models/legal-notice-reviewer.Modelfile
# Any installed model name works here too (e.g. qwen2.5:7b).
MODEL_FAST=legal-notice-reviewer
MODEL_BALANCED=legal-notice-reviewer
MODEL_CAPABLE=legal-notice-reviewer
MODEL_VISION=legal-notice-reader

# ---- Generation -------------------------------------------------------------------
# Context window (prompt + answer). A notice with its instructions needs ~6-10k tokens.
NUM_CTX=16384
TEMPERATURE=0
# How long Ollama keeps a model in memory after a request
KEEP_ALIVE=30m
# Ask "thinking" models (Qwen3) to answer directly
DISABLE_THINKING=true
# Per model call. Keep below the backend's 10-minute stale-job window.
TIMEOUT_MS=480000
# Model calls at once (1 for a single laptop GPU)
MAX_CONCURRENCY=1
MAX_OUTPUT_TOKENS=8192
# Show the JSON structure in the prompt (small models need it)
SCHEMA_IN_PROMPT=true
# Extra attempts when the answer does not match the JSON schema
REPAIR_RETRIES=1

# ---- Scans and photos --------------------------------------------------------------
VISION_MAX_PAGES=20
# Longest side in pixels of each page image sent to the vision model
VISION_MAX_SIDE=1400
MAX_BODY_MB=60
